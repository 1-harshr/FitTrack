CREATE TABLE ExerciseEntryEntity (
    id              TEXT    NOT NULL PRIMARY KEY,
    workoutId       TEXT    NOT NULL,
    exerciseId      TEXT    NOT NULL,
    exerciseName    TEXT    NOT NULL,           -- snapshot from catalog at log time
    orderIndex      INTEGER NOT NULL,
    FOREIGN KEY(workoutId) REFERENCES WorkoutEntity(id) ON DELETE CASCADE
);

CREATE INDEX exercise_entry_workout ON ExerciseEntryEntity(workoutId, orderIndex);

insert:
INSERT INTO ExerciseEntryEntity(id, workoutId, exerciseId, exerciseName, orderIndex)
VALUES (?, ?, ?, ?, ?);

delete:
DELETE FROM ExerciseEntryEntity WHERE id = ?;

selectForWorkout:
SELECT * FROM ExerciseEntryEntity WHERE workoutId = ? ORDER BY orderIndex;

nextOrderIndex:
SELECT COALESCE(MAX(orderIndex) + 1, 0) FROM ExerciseEntryEntity WHERE workoutId = ?;
