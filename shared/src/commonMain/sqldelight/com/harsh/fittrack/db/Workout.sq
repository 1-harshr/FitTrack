CREATE TABLE WorkoutEntity (
    id              TEXT    NOT NULL PRIMARY KEY,
    userId          TEXT    NOT NULL,
    title           TEXT    NOT NULL,
    date            TEXT    NOT NULL,           -- ISO LocalDate  e.g. "2026-05-14"
    startedAt       INTEGER NOT NULL,           -- epoch ms, for intra-day ordering
    durationSeconds INTEGER NOT NULL DEFAULT 0,
    totalVolumeKg   REAL    NOT NULL DEFAULT 0.0,
    isCompleted     INTEGER NOT NULL DEFAULT 0  -- 0 / 1
);

CREATE INDEX workout_user_started ON WorkoutEntity(userId, startedAt DESC);

insert:
INSERT INTO WorkoutEntity(id, userId, title, date, startedAt, durationSeconds, totalVolumeKg, isCompleted)
VALUES (?, ?, ?, ?, ?, 0, 0.0, 0);

updateTitle:
UPDATE WorkoutEntity SET title = ? WHERE id = ?;

markCompleted:
UPDATE WorkoutEntity
SET isCompleted = 1, durationSeconds = ?, totalVolumeKg = ?
WHERE id = ?;

delete:
DELETE FROM WorkoutEntity WHERE id = ?;

selectAllForUser:
SELECT * FROM WorkoutEntity
WHERE userId = ? AND isCompleted = 1
ORDER BY startedAt DESC;

selectActiveForUser:
SELECT * FROM WorkoutEntity
WHERE userId = ? AND isCompleted = 0
LIMIT 1;

selectById:
SELECT * FROM WorkoutEntity WHERE id = ?;
